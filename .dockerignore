# Secrets must never enter the build context.
.env
.env.*
!.env.example

# Local virtualenv: the image builds its own at /opt/venv.
.venv/
venv/

# Caches and build junk
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Version control and editor state
.git/
.gitignore
.vscode/

# Nothing in the image needs these
docs/
tests/
specs/
*.md
.DS_Store
.data/

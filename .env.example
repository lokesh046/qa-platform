# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is a placeholder. No real credentials belong in this file.
#
# Hostnames here are the LOCALHOST variants, so this file works when you run
# the API from your shell with `uv run`. docker-compose.yml overrides
# DATABASE_URL, REDIS_URL and BACKEND_BASE_URL with the in-network service
# names, so you do not maintain two env files.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local                 # local | ci | staging | production
APP_NAME=qa-platform
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL ------------------------------------------------------------
# Used by docker compose to initialise the database container.
POSTGRES_USER=qa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qa_platform
# Used by the API. Compose rewrites the host to "postgres".
# The scheme must be exactly postgresql+psycopg: the app validates it, because
# a bare postgresql:// URL makes SQLAlchemy reach for psycopg2.
DATABASE_URL=postgresql+psycopg://qa:change-me@localhost:5432/qa_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# Logs every SQL statement including bound parameters. Local debugging only;
# the app refuses to start with this on when APP_ENV is staging or production.
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
# Compose rewrites the host to "redis".
REDIS_URL=redis://localhost:6379/0
# How long to wait for a Redis connection or reply, in seconds. Keep it below
# the readiness probe's own timeout so /ready answers rather than hangs.
REDIS_TIMEOUT_SECONDS=5

# --- Object storage (Phase 3; provider not yet chosen) ---------------------
# Nothing stores an artifact before Phase 3. MinIO's container images are no
# longer publicly pullable, so no object-storage service is in the stack and
# these variables are commented out on purpose. Phase 3 picks a provider and
# names the variables; see docs/decisions/ADR-005-object-storage-deferred.md.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=qa-artifacts

# --- Host port mappings ----------------------------------------------------
# Only affects which port on your machine maps to the container. Change one if
# something already owns the default -- a Homebrew redis-server on 6379, or
# another project's Postgres container on 5432, are both common.
# Remember to update DATABASE_URL / REDIS_URL to match if you do.
#
# Verify a mapping actually took effect with:
#   docker inspect qa-platform-postgres-1 --format '{{json .NetworkSettings.Ports}}'
# An empty list there means the port was NOT published, and a host connection
# will silently reach whatever else is on that port.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
MCP_HOST_PORT=8765

# --- Jira (Jira Cloud, service account) ------------------------------------
# The token belongs to a dedicated read-only service account, not to a person.
# Your Jira Cloud tenant. The placeholder host below deliberately ends in
# .invalid, which RFC 2606 guarantees will never resolve. Do not use a
# your-tenant.atlassian.net placeholder: *.atlassian.net has wildcard DNS, so
# it resolves, and an unconfigured service then sends real requests to
# Atlassian. That was observed during Step 6.
JIRA_BASE_URL=https://your-tenant.invalid
JIRA_SERVICE_EMAIL=svc-qa-platform@example.com
JIRA_API_TOKEN=replace-with-atlassian-api-token
JIRA_TIMEOUT_SECONDS=10
JIRA_CACHE_TTL_SECONDS=300

# --- Internal auth: MCP server -> FastAPI backend --------------------------
# Shared service token. The backend compares it in constant time.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=replace-with-a-long-random-string

# --- MCP server ------------------------------------------------------------
# stdio for Copilot Chat on your machine; http for the compose container.
MCP_TRANSPORT=stdio           # stdio | http
MCP_HOST=127.0.0.1            # only used when MCP_TRANSPORT=http
MCP_PORT=8765                 # only used when MCP_TRANSPORT=http
# Base URL of the backend as seen by the MCP server.
# Compose rewrites this to "http://api:8000".
BACKEND_BASE_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=15
# Identity the MCP server reports to the backend for audit records.
QA_ACTOR_EMAIL=you@example.com

# --- Document generation (BRD) ---------------------------------------------
# An OpenAI-compatible chat-completions endpoint. The default is GitHub
# Models, which every GitHub account can reach, rate limited, at no cost.
# Changing provider means changing these three values and nothing else.
# See docs/decisions/ADR-023-openai-compatible-client-github-models-default.md
LLM_BASE_URL=https://models.github.ai/inference
# No default on purpose: GitHub Models names models by publisher and the
# catalogue changes, so a default here would be a guess.
# List them with: curl https://models.github.ai/catalog/models
LLM_MODEL=
# A GitHub fine-grained token scoped models:read. NOT the OAuth app secret
# below, and NOT the Jira token above.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2

# --- Remote access and identity (http transport only) ----------------------
# oauth: the MCP server is an OAuth 2.1 authorization server, GitHub performs
#   the login, and the access token carries the user's verified email.
# service_token: the older behaviour, where a shared token plus an
#   X-Actor-Email header is accepted. It trusts the header, so it is for local
#   use only and never for an exposed port.
# See docs/decisions/ADR-022-remote-access-and-oauth-identity.md
MCP_AUTH_MODE=service_token   # oauth | service_token
# The externally reachable base URL of the MCP server. Becomes the OAuth
# issuer, so it must be what the client actually dialled.
MCP_PUBLIC_URL=http://127.0.0.1:8765
# From a GitHub OAuth app whose callback URL is
# <MCP_PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the MCP server's own tokens. Per environment: a shared key would let
# one environment mint tokens another accepts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_TOKEN_SIGNING_KEY=
# Session state only: authorization codes and registered clients.
MCP_REDIS_URL=redis://localhost:6380/1
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=86400
